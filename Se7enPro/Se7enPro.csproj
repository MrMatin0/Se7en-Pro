<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Se7enPro</RootNamespace>
    <AssemblyName>Se7enCore</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64;x86;AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <Product>Se7en Pro</Product>
    <Company>Se7en Pro</Company>
    <Description>Se7en Pro — modern Windows client</Description>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\psiphon-tunnel-core.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Include="Resources\server_entries.txt" Condition="Exists('Resources\server_entries.txt')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Resources\server_entries.bin" Condition="Exists('Resources\server_entries.bin')">
      <LogicalName>Se7enPro.Resources.server_entries.bin</LogicalName>
    </EmbeddedResource>

    <Content Include="Resources\tun2socks\tun2socks.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\tun2socks\wintun.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="Resources\aether\aether.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\aether\pt\lyrebird.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="Resources\tor\tor.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\tor\pluggable_transports\lyrebird.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\tor\pluggable_transports\conjure-client.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\tor\data\geoip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\tor\data\geoip6">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="Resources\xray\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\sing_box\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="Resources\shard\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <EmbeddedResource Include="Resources\akamai_seed_ips.txt" />
    <EmbeddedResource Include="Resources\akamai_ip_ranges.txt" />
    <EmbeddedResource Include="Resources\cloudflare_ip_ranges.txt" />
    <EmbeddedResource Include="Resources\fastly_ip_ranges.txt" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <!--
    The release package is assembled by copying this project's publish
    folder next to the Flutter GUI, so every bundled helper binary has to
    be present in $(PublishDir)\Resources. Leaving that to <Content> copy
    semantics alone is fragile under self-contained single-file publish:
    CI failed with "Package is incomplete, missing:
    Resources\psiphon-tunnel-core.exe" even though the file is committed.
    Copy the folder explicitly (source tree is the source of truth), with
    retries, and print the count so a short copy is obvious in the log.
  -->
  <Target Name="CopySe7enResourcesToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_Se7enResourceFile Include="$(MSBuildProjectDirectory)\Resources\**\*"
                          Exclude="$(MSBuildProjectDirectory)\Resources\*.txt;
                                   $(MSBuildProjectDirectory)\Resources\server_entries.*;
                                   $(MSBuildProjectDirectory)\Resources\**\*.toml" />
    </ItemGroup>

    <Copy SourceFiles="@(_Se7enResourceFile)"
          DestinationFiles="@(_Se7enResourceFile->'$(PublishDir)Resources\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="500" />

    <Message Importance="high"
             Text="Se7en: staged @(_Se7enResourceFile->Count()) bundled resource files into $(PublishDir)Resources\" />
  </Target>

</Project>
